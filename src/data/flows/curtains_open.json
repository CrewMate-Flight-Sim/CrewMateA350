{
  "id": "open_curtains",
  "name": "Open Curtains",
  "steps": [
    {
      "label": "Cockpit Door Open",
      "read": "(L:INI_COCKPIT_DOOR)",
      "on": "1 (>L:INI_COCKPIT_DOOR)",
      "expect": 1
    },
    {
      "label": "Armrest up",
      "read": "(L:INI_A350_INT_SEAT_FO_ARMREST_L_BASE)",
      "on": "1 (>L:INI_A350_INT_SEAT_FO_ARMREST_L_BASE)",
      "expect": 1
    },
    {
      "label": "Seat back",
      "read": "(L:INI_SEAT_FO_BKFWD_ANIMATION)",
      "on": "0 (>L:INI_SEAT_FO_BKFWD_SWITCH)",
      "release": "1 (>L:INI_SEAT_FO_BKFWD_SWITCH)",
      "until": "at_most",
      "expect": 1,
      "timeout_ms": 20000,
      "wait_ms": 3000
    },
    {
      "label": "Seat forward",
      "read": "(L:INI_SEAT_FO_BKFWD_ANIMATION)",
      "on": "2 (>L:INI_SEAT_FO_BKFWD_SWITCH)",
      "release": "1 (>L:INI_SEAT_FO_BKFWD_SWITCH)",
      "until": "at_least",
      "expect": 80,
      "timeout_ms": 20000
    },
    {
      "label": "Armrest down",
      "read": "(L:INI_A350_INT_SEAT_FO_ARMREST_L_BASE)",
      "on": "0 (>L:INI_A350_INT_SEAT_FO_ARMREST_L_BASE)",
      "expect": 0
    },
    {
      "label": "Curtain 1 Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN1_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN1_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 1 M Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN1_M_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN1_M_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 2 Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN2_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN2_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 2 M Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN2_M_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN2_M_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 4 Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN4_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN4_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 5 Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN5_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN5_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 5 M Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN5_M_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN5_M_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 6 Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN6_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN6_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 6 M Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN6_M_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN6_M_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 7 Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN7_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN7_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 7 M Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN7_M_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN7_M_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 8 Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN8_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN8_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 8 M Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN8_M_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN8_M_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 9 Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN9_VIS)",
      "on": "1 (>L:INI_SKEL_CAB_CURTAIN9_VIS)",
      "expect": 1
    },
    {
      "label": "Curtain 10 Open",
      "read": "(L:INI_SKEL_CAB_CURTAIN10_VIS)",
