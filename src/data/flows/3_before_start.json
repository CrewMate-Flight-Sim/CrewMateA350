{
  "id": "before_start",
  "name": "Before Start",
  "steps": [
    {
      "label": "Seat readjust back",
      "read": "(L:INI_SEAT_FO_BKFWD_ANIMATION)",
      "on": "0 (>L:INI_SEAT_FO_BKFWD_SWITCH)",
      "release": "1 (>L:INI_SEAT_FO_BKFWD_SWITCH)",
      "until": "at_most",
      "expect": 70,
      "timeout_ms": 20000
    },
    {
      "label": "Seat readjust forward",
      "read": "(L:INI_SEAT_FO_BKFWD_ANIMATION)",
      "on": "2 (>L:INI_SEAT_FO_BKFWD_SWITCH)",
      "release": "1 (>L:INI_SEAT_FO_BKFWD_SWITCH)",
      "until": "at_least",
      "expect": 80,
      "timeout_ms": 20000
    },
    {
      "label": "Cockpit Door close",
      "read": "(L:INI_COCKPIT_DOOR)",
      "on": "0 (>L:INI_COCKPIT_DOOR)",
      "expect": 0
    },
    {
      "label": "Cockpit Door Lock",
      "read": "(L:INI_COCKPIT_DOOR_LOCK)",
      "on": "1 (>L:INI_COCKPIT_DOOR_LOCK)",
      "expect": 1
    },
    {
      "label": "HUD Deploy",
      "read": "(L:INI_HUD_RIGHT_STATE)",
      "on": "1 (>L:INI_HUD_RIGHT_STATE)",
      "expect": 1,
      "only_if": {
        "read": "(L:INI_IS_HUD)",
        "one_of": [1]
      }
    },
    {
      "label": "HUD Uncover",
      "read": "(L:INI_HUD_COVER_RIGHT)",
      "on": "0 (>L:INI_HUD_COVER_RIGHT)",
      "expect": 0,
      "only_if": {
        "read": "(L:INI_IS_HUD)",
        "one_of": [1]
      }
    },
    {
      "label": "HUD Bright on",
      "read": "(L:INI_HUD_BRIGHTNESS_RIGHT)",
      "on": "100 (>L:INI_HUD_BRIGHTNESS_RIGHT)",
      "expect": 100,
      "only_if": {
        "read": "(L:INI_IS_HUD)",
        "one_of": [1]
      }
    },
    {
      "label": "SURV MCDU",
      "read": "(L:INI_MCDU2_SURV)",
      "on": "1 (>L:INI_MCDU2_SURV)",
      "expect": 1,
      "skip_verify": true
    },
    {
      "label": "TCAS",
      "read": "(L:INI_TCAS_STBY_STATE)",
      "on": "1 (>L:INI_TCAS_STBY_STATE)",
      "expect": 1
    },
    {
      "label": "TCAS",
      "read": "(L:INI_tcas_mode_pedestal)",
      "on": "2 (>L:INI_tcas_mode_pedestal)",
      "expect": 2
    },
    {
      "label": "Remove Chocks",
      "read": "(L:INI_CHOCKS_ENABLED)",
      "on": "0 (>L:INI_CHOCKS_ENABLED)",
      "expect": 0
    }
  ]
}
